<?xml version="1.0"?>
<!--
  route_nav_bt.xml — behavior tree for route-server navigation.

  Uses the route_server (ComputeAndTrackRoute) to follow a predefined GeoJSON
  graph of waypoints rather than planning freely to any pose.  Constraining the
  robot to known corridors improves reliability in environments with narrow gaps.

  The path follower starts 0.5 s after route tracking to give the route
  server time to compute the initial path before the controller tries to
  follow it.

  Recovery cycles through: clear costmap → wait 1 s → back up 0.3 m.
  Up to 6 retries.  If a new goal arrives mid-recovery, GoalUpdated exits
  recovery immediately.
-->
<root BTCPP_format="4" main_tree_to_execute="NavigateWithRouteTracking">

  <BehaviorTree ID="NavigateWithRouteTracking">

    <!-- Wraps the whole tree — on failure, triggers recovery up to 6 times -->
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">

      <PipelineSequence name="NavigateWithTracking">

        <!-- Allow the controller plugin to be selected at runtime via topic -->
        <ControllerSelector
          selected_controller="{selected_controller}"
          default_controller="FollowPath"
          topic_name="controller_selector"/>

        <!-- Run route tracking and path following in parallel.
             success_threshold=1 means either child succeeding = overall success. -->
        <Parallel
          name="TrackAndFollow"
          success_threshold="1"
          failure_threshold="1">

          <!-- Route server streams waypoints continuously as the robot moves -->
          <ComputeAndTrackRoute
            goal="{goal}"
            path="{path}"
            route="{route}"
            use_poses="true"/>

          <!-- 0.5 s delay before following so the route server produces first path -->
          <Sequence name="DelayedFollowPath">
            <Wait wait_duration="0.5"/>
            <FollowPath
              path="{path}"
              controller_id="{selected_controller}"/>
          </Sequence>

        </Parallel>

      </PipelineSequence>

      <!-- Recovery branch: runs when NavigateWithTracking fails -->
      <ReactiveFallback name="RecoveryFallback">

        <!-- Abort recovery immediately if the goal changed -->
        <GoalUpdated/>

        <!-- Cycle through recovery actions one at a time on each retry -->
        <RoundRobin name="RecoveryActions">

          <!-- Stale obstacle data is the most common cause — clear it first -->
          <ClearEntireCostmap
            service_name="local_costmap/clear_entirely_local_costmap"/>

          <!-- Pause to let dynamic obstacles move out of the way -->
          <Wait wait_duration="1.0"/>

          <!-- Back up in case the robot is stuck against something -->
          <BackUp
            backup_dist="0.30"
            backup_speed="0.15"/>

        </RoundRobin>

      </ReactiveFallback>

    </RecoveryNode>

  </BehaviorTree>

</root>
